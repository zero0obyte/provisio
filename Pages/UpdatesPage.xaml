<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Provisio.Pages.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Provisio.Services">

    <Grid Padding="36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="Package updates" svc:L.Key="updates.title" Style="{ThemeResource TitleLargeTextBlockStyle}" />
            <TextBlock svc:L.Key="updates.subtitle" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <InfoBar
            x:Name="NoWingetBar"
            Grid.Row="1"
            Margin="0,0,0,12"
            Severity="Warning"
            IsOpen="False"
            IsClosable="False"
            svc:L.MessageKey="updates.nowinget" />

        <Grid Grid.Row="2" Margin="0,0,0,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="CheckButton" Content="Check for updates" svc:L.Key="updates.check" Click="Check_Click" />
            <CheckBox Grid.Column="1" x:Name="SelectAllBox" Content="Select all" svc:L.Key="common.selectall" IsChecked="True" Checked="SelectAll_Toggled" Unchecked="SelectAll_Toggled" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <ListView x:Name="UpdatesList" Grid.Row="3" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}" MinWidth="0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Id}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Versions}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="{Binding Status, Mode=OneWay}" VerticalAlignment="Center" HorizontalTextAlignment="Right" FontSize="12" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border
            Grid.Row="4"
            Margin="0,12,0,0"
            Padding="12"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1">
            <ScrollViewer x:Name="LogScroll">
                <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,16,0,0">
            <Button x:Name="UpdateSelectedButton" Content="Update selected" svc:L.Key="updates.updateselected" Click="UpdateSelected_Click" />
            <Button x:Name="UpdateAllButton" Content="Update all" svc:L.Key="updates.updateall" Style="{ThemeResource AccentButtonStyle}" Click="UpdateAll_Click" />
        </StackPanel>
    </Grid>
</Page>
