<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Provisio.Pages.KitSelectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Provisio.Services">

    <Grid Padding="36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="Welcome to Provisio" svc:L.Key="kits.title" Style="{ThemeResource TitleLargeTextBlockStyle}" />
            <TextBlock
                svc:L.Key="kits.subtitle"
                TextWrapping="Wrap"
                Style="{ThemeResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <GridView
            x:Name="KitsGrid"
            Grid.Row="1"
            SelectionMode="Multiple"
            IsItemClickEnabled="True"
            ItemClick="KitsGrid_ItemClick">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Grid Width="240" Height="130" Padding="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{Binding Icon}" FontSize="26" VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding Name}"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <TextBlock
                            Grid.Row="1"
                            Text="{Binding Description}"
                            TextWrapping="Wrap"
                            Margin="0,8,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,20,0,0">
            <TextBlock x:Name="SelectionCount" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="Review selections" svc:L.Key="kits.review" Click="Review_Click" />
            <Button Content="Start setup" svc:L.Key="kits.start" Style="{ThemeResource AccentButtonStyle}" Click="Start_Click" />
        </StackPanel>
    </Grid>
</Page>
