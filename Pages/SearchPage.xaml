<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Provisio.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:Provisio.Services">

    <Grid Padding="36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="Search everything" svc:L.Key="search.title" Style="{ThemeResource TitleLargeTextBlockStyle}" />
            <AutoSuggestBox
                x:Name="SearchBox"
                svc:L.PlaceholderKey="search.placeholder"
                PlaceholderText="Find apps and tweaks across all kits…"
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged" />
        </StackPanel>

        <ListView x:Name="ResultsList" Grid.Row="1" />
    </Grid>
</Page>
